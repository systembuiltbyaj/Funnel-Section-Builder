# Anthropic API key — used only by POST /api/generate-section to generate
# section HTML. Without it the route returns 503 and the builder falls back to
# copying the master prompt, which still works.
#
# Set a HARD MONTHLY BUDGET CAP in the Anthropic console. The app is public and
# has no accounts, so there is no reliable per-user limit — that cap is the
# real backstop against an unexpected bill.
ANTHROPIC_API_KEY=
