{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-routing-doc.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking CLAUDE.md routing table"
          }
        ]
      }
    ]
  }
}
